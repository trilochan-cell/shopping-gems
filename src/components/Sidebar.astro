---
import Icon from './Icon.astro';

interface RecentPost {
  slug: string;
  title: string;
  pubDate: Date;
  image?: string;
  imageAlt?: string;
}
interface Props {
  recent: RecentPost[];
  categories: { name: string; slug: string; count: number }[];
  tags: string[];
}
const { recent, categories, tags } = Astro.props;
const fmt = (d: Date) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
  <!-- Search -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-3 text-sm font-extrabold uppercase tracking-widest text-slate-900">Search</h3>
    <form action="/search" method="get" class="flex gap-2">
      <input type="search" name="s" placeholder="Search deals…" aria-label="Search" class="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-base outline-none focus:border-brand focus:ring-2 focus:ring-pearl-aqua-600 sm:text-sm" />
      <button type="submit" class="rounded-lg bg-brand px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-dark" aria-label="Search"><Icon name="search" cls="h-4 w-4" /></button>
    </form>
  </div>

  <!-- Deal promo -->
  <div class="overflow-hidden rounded-xl bg-neutral-900 p-5 text-white shadow-sm">
    <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[2px] text-almond-silk"><Icon name="flame" cls="h-3.5 w-3.5" /> Trending deal</p>
    <h3 class="mt-2 text-lg font-extrabold leading-snug">Best Amazon Deals You Can't Miss!</h3>
    <p class="mt-1 text-sm text-slate-300">Lightning deals, gifts under $20 &amp; more.</p>
    <a href="/deals" class="mt-4 inline-block rounded-full bg-brand px-5 py-2.5 text-sm font-bold text-white hover:bg-brand-dark">Grab deals</a>
  </div>

  <!-- Latest posts -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-extrabold uppercase tracking-widest text-slate-900">Latest Posts</h3>
    <div class="space-y-4">
      {recent.map((p) => (
        <a href={`/posts/${p.slug}/`} class="group flex gap-3">
          {p.image && <img src={p.image} alt={p.imageAlt ?? p.title} loading="lazy" class="h-16 w-20 shrink-0 rounded-lg object-cover" />}
          <span>
            <span class="block text-[14px] font-bold leading-snug group-hover:text-brand">{p.title}</span>
            <span class="mt-1 block text-[12px] text-slate-500">{fmt(p.pubDate)}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- Categories -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-3 text-sm font-extrabold uppercase tracking-widest text-slate-900">Categories</h3>
    <ul class="divide-y divide-slate-100">
      {categories.map((c) => (
        <li>
          <a href={`/category/${c.slug}/`} class="flex items-center justify-between py-2.5 text-[14.5px] font-semibold text-slate-700 hover:text-brand">
            {c.name}
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[12px] font-bold text-slate-600">{c.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Tags -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-3 text-sm font-extrabold uppercase tracking-widest text-slate-900">Tags</h3>
    <div class="flex flex-wrap gap-2">
      {tags.map((t) => (
        <a href={`/tag/${t}/`} class="rounded-full border border-slate-200 px-3 py-1 text-[13px] font-semibold text-slate-600 hover:border-brand hover:text-brand">#{t}</a>
      ))}
    </div>
  </div>

  <!-- Newsletter -->
  <div class="rounded-xl border border-dashed border-tangerine-dream-700 bg-almond-silk-900 p-5">
    <h3 class="flex items-center gap-1.5 text-base font-extrabold"><Icon name="mail" cls="h-4 w-4 text-brand" /> Never miss a deal</h3>
    <p class="mt-1 text-sm text-slate-600">Sale alerts &amp; coupons, once a week.</p>
    <form class="mt-3 space-y-2" action="mailto:hello@shoppinggems.local" method="post" enctype="text/plain">
      <input type="email" name="email" required placeholder="Your email" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-base outline-none focus:border-brand focus:ring-2 focus:ring-pearl-aqua-600 sm:text-sm" />
      <button type="submit" class="w-full rounded-lg bg-neutral-900 px-4 py-2 text-sm font-bold text-white hover:bg-ink">Subscribe</button>
    </form>
  </div>
</aside>
