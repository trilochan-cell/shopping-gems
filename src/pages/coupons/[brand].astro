---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((b) => ({ params: { brand: b.slug }, props: { slug: b.slug } }));
}
const { slug } = Astro.props;
const brands = await getCollection('brands');
const brand = brands.find((b) => b.slug === slug)!;
const allCoupons = await getCollection('coupons');
const today = new Date();
const isActive = (c: (typeof allCoupons)[number]) => new Date(c.data.expiry) >= today;
const offers = allCoupons.filter((c) => c.data.brand === slug).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.uses - a.data.uses);
const active = offers.filter(isActive);
const expired = offers.filter((c) => !isActive(c));
const codes = active.filter((c) => c.data.type === 'code');
const deals = active.filter((c) => c.data.type === 'deal');
const similar = brands.filter((b) => b.slug !== slug).slice(0, 4);

// Sidebar (blog cross-links for SEO)
const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const recent = posts.slice(0, 4).map((p) => ({ slug: p.slug, title: p.data.title, pubDate: p.data.pubDate, image: p.data.image, imageAlt: p.data.imageAlt }));
const categories = [...new Set(posts.map((p) => p.data.category))].map((c) => ({ name: c, slug: slugify(c), count: posts.filter((p) => p.data.category === c).length }));
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = (d: Date) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const monthYear = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const stars = '★'.repeat(Math.round(brand.data.rating)) + '☆'.repeat(5 - Math.round(brand.data.rating));
const pageUrl = `http://localhost:4321/coupons/${brand.slug}/`;
---
<BaseLayout
  title={`${brand.data.name} Promo Codes & Coupons — Up to ${brand.data.maxDiscount} Off`}
  description={`Verified ${brand.data.name} promo codes & deals for ${monthYear}. Save up to ${brand.data.maxDiscount} with ${active.length} active offers, tested by Shopping Gems.`}
  type="website"
  tags={[brand.data.name.toLowerCase(), 'coupons', 'promo codes']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "http://localhost:4321/" },
        { "@type": "ListItem", "position": 2, "name": "Coupons", "item": "http://localhost:4321/coupons" },
        { "@type": "ListItem", "position": 3, "name": brand.data.name }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": `${brand.data.name} coupons & deals`,
      "numberOfItems": active.length,
      "itemListElement": active.map((c, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "Offer",
          "name": c.data.title,
          "description": c.data.description,
          "url": pageUrl,
          "availability": "https://schema.org/InStock",
          "validThrough": new Date(c.data.expiry).toISOString().split('T')[0],
          "seller": { "@type": "Organization", "name": brand.data.name, "url": brand.data.website }
        }
      }))
    })} />
    {brand.data.faq.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": brand.data.faq.map((f) => ({
          "@type": "Question",
          "name": f.question,
          "acceptedAnswer": { "@type": "Answer", "text": f.answer }
        }))
      })} />
    )}
  </Fragment>

  <nav aria-label="Breadcrumb" class="my-[18px] flex flex-wrap items-center gap-1.5 text-[13px] text-slate-500">
    <a href="/" class="hover:text-brand">Home</a><span aria-hidden="true">/</span>
    <a href="/coupons" class="hover:text-brand">Coupons</a><span aria-hidden="true">/</span>
    <span class="text-slate-700">{brand.data.name}</span>
  </nav>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0 space-y-6">

      <!-- Brand header -->
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
        <div class="flex flex-wrap items-start gap-4">
          {brand.data.logo ? (
            <img src={brand.data.logo} alt={`${brand.data.name} logo`} width="64" height="64" class="h-16 w-16 shrink-0 rounded-xl border border-slate-200 bg-white object-contain" />
          ) : (
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-xl bg-brand font-display text-3xl font-bold text-white" aria-hidden="true">{brand.data.name.charAt(0)}</span>
          )}
          <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-extrabold tracking-tight md:text-3xl">{brand.data.name} Promo Codes &amp; Coupons</h1>
            <p class="mt-1 text-[15px] text-slate-600">{brand.data.tagline}</p>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              <span class="font-bold text-amber-500" aria-label={`Rated ${brand.data.rating} out of 5`}>{stars} <span class="font-semibold text-slate-600">{brand.data.rating} ({brand.data.reviews.toLocaleString()} reviews)</span></span>
              <span class="flex items-center gap-1 font-semibold text-emerald-700"><Icon name="check" cls="h-4 w-4" /> {active.length} verified offers</span>
            </div>
          </div>
          <a href={brand.data.website} target="_blank" rel="nofollow sponsored noopener" class="rounded-full bg-brand px-6 py-3 text-sm font-bold text-white hover:bg-brand-dark">Go to Store →</a>
        </div>
        <p class="mt-4 border-t border-slate-100 pt-4 text-[15px] leading-relaxed text-slate-600">{brand.data.description}</p>
      </section>

      <p class="text-sm text-slate-500">Recommended {brand.data.name} coupons for {monthYear} — tested by the Shopping Gems team.</p>

      <!-- Tabs -->
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter offers">
        <button data-filter="all" role="tab" aria-selected="true" class="coupon-tab rounded-full bg-neutral-900 px-5 py-2 text-sm font-bold text-white">All ({active.length})</button>
        <button data-filter="code" role="tab" aria-selected="false" class="coupon-tab rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-bold text-slate-700 hover:border-brand">Codes ({codes.length})</button>
        <button data-filter="deal" role="tab" aria-selected="false" class="coupon-tab rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-bold text-slate-700 hover:border-brand">Deals ({deals.length})</button>
      </div>

      <!-- Offer list -->
      <div id="offer-list" class="space-y-4">
        {active.map((c) => (
          <article id={`coupon-${c.slug}`} data-type={c.data.type} class="coupon-card scroll-mt-28 overflow-hidden rounded-xl border bg-white shadow-sm transition hover:shadow-md ${c.data.featured ? 'border-2 border-brand' : 'border-slate-200'}">
            <div class="flex flex-col sm:flex-row">
              <div class="flex shrink-0 items-center justify-center gap-2 bg-slate-50 px-5 py-4 text-center sm:w-36 sm:flex-col">
                <span class="font-display text-xl font-bold leading-tight text-brand">{c.data.badge}</span>
                <span class="rounded-full bg-slate-200 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-slate-700">{c.data.type === 'code' ? 'Code' : 'Deal'}</span>
              </div>
              <div class="min-w-0 flex-1 p-4 md:p-5">
                <h2 class="font-sans! text-[17px] font-extrabold leading-snug text-slate-900">{c.data.title}</h2>
                <p class="text-sm leading-relaxed text-slate-600">{c.data.description}</p>
                <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-slate-500">
                  {c.data.verified && <span class="flex items-center gap-1 font-semibold text-emerald-700"><Icon name="check" cls="h-3.5 w-3.5" /> Verified {fmt(c.data.verified)}</span>}
                  <span class="flex items-center gap-1"><Icon name="eye" cls="h-3.5 w-3.5" /> {c.data.uses.toLocaleString()} uses</span>
                  <span class="flex items-center gap-1 font-semibold text-amber-700"><Icon name="calendar" cls="h-3.5 w-3.5" /> Ends {fmt(c.data.expiry)}</span>
                </div>
                {c.data.labels.length > 0 && <p class="mt-2 text-[12px] text-slate-500">Labels: {c.data.labels.join(' · ')}</p>}
                {(c.data.terms.length > 0) && (
                  <details class="mt-2 text-sm">
                    <summary class="cursor-pointer font-semibold text-ink hover:text-brand [&::-webkit-details-marker]:hidden">Terms &amp; details +</summary>
                    <ul class="mt-1.5 list-disc space-y-1 pl-5 text-slate-600">{c.data.terms.map((t) => <li>{t}</li>)}</ul>
                  </details>
                )}
              </div>
              <div class="flex shrink-0 items-center p-4 md:p-5 sm:w-44 sm:justify-center sm:border-l sm:border-slate-100">
                {c.data.type === 'code' && c.data.code ? (
                  <div class="w-full">
                    <button
                      type="button"
                      class="coupon-open block w-full rounded-lg bg-brand px-5 py-3 text-center text-sm font-bold text-white hover:bg-brand-dark"
                      data-kind="code"
                      data-code={c.data.code}
                      data-title={c.data.title}
                      data-badge={c.data.badge}
                      data-expiry={fmt(c.data.expiry)}
                      data-store={brand.data.website}
                    >Show Code</button>
                    <noscript><p class="mt-2 rounded-lg border-2 border-dashed border-brand bg-rose-50 p-2 text-center font-mono text-sm font-bold text-brand-dark">Code: {c.data.code}</p></noscript>
                  </div>
                ) : (
                  <a
                    href={brand.data.website}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="coupon-open block w-full rounded-lg bg-neutral-900 px-5 py-3 text-center text-sm font-bold text-white hover:bg-ink"
                    data-kind="deal"
                    data-title={c.data.title}
                    data-badge={c.data.badge}
                    data-expiry={fmt(c.data.expiry)}
                    data-store={brand.data.website}
                  >Get Deal →</a>
                )}
              </div>
            </div>
          </article>
        ))}
        {active.length === 0 && <p class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">No active offers right now — check back soon or browse expired codes below.</p>}
      </div>

      <!-- Expired -->
      {expired.length > 0 && (
        <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
          <h2 class="text-xl font-extrabold">Expired {brand.data.name} coupons</h2>
          <p class="mt-1 text-sm text-slate-500">Dead codes, kept for reference — try them anyway, occasionally one reactivates.</p>
          <ul class="mt-3 divide-y divide-slate-200">
            {expired.map((c) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-sm">
                <span class="text-slate-600"><strong class="text-slate-800">{c.data.badge}</strong> — {c.data.title} <span class="text-slate-400">(ended {fmt(c.data.expiry)})</span></span>
                {c.data.code && <code class="rounded bg-slate-200 px-2.5 py-1 font-mono text-[13px] font-bold text-slate-500 line-through">{c.data.code}</code>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Stats strip -->
      <section aria-label="Offer statistics" class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {[['All Discounts', String(offers.length)], ['All Codes', String(allCoupons.filter((c) => c.data.brand === slug && c.data.type === 'code').length)], ['Maximum Discount', brand.data.maxDiscount], ['All Deals', String(deals.length)]].map(([label, value]) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4 text-center shadow-sm">
            <p class="font-display text-2xl font-bold text-brand">{value}</p>
            <p class="mt-0.5 text-[12px] font-bold uppercase tracking-wider text-slate-500">{label}</p>
          </div>
        ))}
      </section>

      <!-- How to use -->
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
        <h2 class="text-xl font-extrabold">How to use a {brand.data.name} coupon</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-slate-600">
          <li>Pick an offer above and click <strong>Show Code</strong> (or <strong>Get Deal</strong> for automatic discounts).</li>
          <li>Copy the code, then head to the {brand.data.name} store — it opens in a new tab.</li>
          <li>Shop as normal and paste the code into the promo box at checkout.</li>
          <li>Confirm the discount appears before paying. Done — you saved money.</li>
        </ol>
      </section>

      <!-- Brand FAQ -->
      {brand.data.faq.length > 0 && (
        <section aria-label="Frequently asked questions" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
          <h2 class="text-xl font-extrabold">{brand.data.name} FAQs</h2>
          <div class="mt-3 space-y-3">
            {brand.data.faq.map((f) => (
              <div class="rounded-lg bg-slate-50 px-4 py-3">
                <h3 class="font-sans text-[15.5px] font-bold text-slate-900">{f.question}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{f.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Similar brands -->
      {similar.length > 0 && (
        <section class="pb-2">
          <h2 class="mb-3 text-xl font-extrabold">Similar brands you may like</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {similar.map((b) => (
              <a href={`/coupons/${b.slug}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-brand">
                {b.data.logo ? (
                  <img src={b.data.logo} alt={`${b.data.name} logo`} width="44" height="44" loading="lazy" class="h-11 w-11 shrink-0 rounded-lg border border-slate-200 bg-white object-contain" />
                ) : (
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-ink font-display text-xl font-bold text-white" aria-hidden="true">{b.data.name.charAt(0)}</span>
                )}
                <span>
                  <span class="block text-[15px] font-extrabold">{b.data.name}</span>
                  <span class="block text-[13px] text-brand">Up to {b.data.maxDiscount} off — view coupons →</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <Sidebar recent={recent} categories={categories} tags={tags} />
  </div>

  <!-- Coupon / deal modal: store opens in a background tab, code shows here -->
  <div id="coupon-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="coupon-modal-title">
    <div id="coupon-modal-backdrop" class="absolute inset-0 bg-black/60"></div>
    <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl">
      <div class="flex items-center justify-between bg-neutral-900 px-5 py-3">
        <p class="flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-widest text-amber-300"><Icon name="tag" cls="h-4 w-4" /> {brand.data.name} coupon</p>
        <button id="coupon-modal-close" type="button" aria-label="Close" class="text-2xl leading-none text-slate-300 hover:text-white">&times;</button>
      </div>
      <div class="p-6 text-center">
        <p id="coupon-modal-badge" class="font-display text-3xl font-bold text-brand"></p>
        <h3 id="coupon-modal-title" class="mt-2 text-lg font-extrabold leading-snug text-slate-900"></h3>
        <div id="coupon-modal-code-wrap" class="mt-4 hidden rounded-xl border-2 border-dashed border-brand bg-rose-50 p-4">
          <p id="coupon-modal-code" class="font-mono text-2xl font-black tracking-[0.2em] text-brand-dark"></p>
          <button id="coupon-modal-copy" type="button" class="mt-3 w-full rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-ink">Copy code</button>
        </div>
        <p id="coupon-modal-deal-note" class="mt-4 hidden rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">This deal applies automatically at the store — no code needed.</p>
        <p class="mt-4 text-[13px] text-slate-500">The {brand.data.name} store opened in a new tab. <span id="coupon-modal-expiry" class="font-semibold text-slate-600"></span></p>
        <a id="coupon-modal-store" href={brand.data.website} target="_blank" rel="nofollow sponsored noopener" class="mt-3 inline-block w-full rounded-lg bg-brand px-5 py-3 text-sm font-bold text-white hover:bg-brand-dark">Continue to Store →</a>
      </div>
    </div>
  </div>

  <script>
    // Tabs filter (progressive enhancement — all offers visible without JS)
    const tabs = document.querySelectorAll('.coupon-tab');
    const cards = document.querySelectorAll('.coupon-card');
    const setTab = (btn) => {
      tabs.forEach((t) => {
        const on = t === btn;
        t.setAttribute('aria-selected', String(on));
        t.className = on
          ? 'coupon-tab rounded-full bg-neutral-900 px-5 py-2 text-sm font-bold text-white'
          : 'coupon-tab rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-bold text-slate-700 hover:border-brand';
      });
    };
    tabs.forEach((btn) => btn.addEventListener('click', () => {
      const f = btn.getAttribute('data-filter');
      setTab(btn);
      cards.forEach((c) => {
        c.classList.toggle('hidden', f !== 'all' && c.getAttribute('data-type') !== f);
      });
    }));
    // Copy helper (clipboard API with fallback)
    async function copyText(text, btn, doneLabel) {
      try { await navigator.clipboard.writeText(text); }
      catch {
        const ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
      }
      const orig = btn.textContent;
      btn.textContent = doneLabel;
      setTimeout(() => { btn.textContent = orig; }, 1500);
    }
    // Coupon modal: open the store in a background tab, show code/deal here
    const modal = document.getElementById('coupon-modal');
    const mBadge = document.getElementById('coupon-modal-badge');
    const mTitle = document.getElementById('coupon-modal-title');
    const mCodeWrap = document.getElementById('coupon-modal-code-wrap');
    const mCode = document.getElementById('coupon-modal-code');
    const mCopy = document.getElementById('coupon-modal-copy');
    const mDealNote = document.getElementById('coupon-modal-deal-note');
    const mStore = document.getElementById('coupon-modal-store');
    const mExpiry = document.getElementById('coupon-modal-expiry');
    const mClose = document.getElementById('coupon-modal-close');
    const mBackdrop = document.getElementById('coupon-modal-backdrop');
    let lastFocus = null;
    function openModal(btn) {
      const store = btn.getAttribute('data-store') || '#';
      window.open(store, '_blank', 'noopener');
      const isCode = btn.getAttribute('data-kind') === 'code';
      mBadge.textContent = btn.getAttribute('data-badge') || '';
      mTitle.textContent = btn.getAttribute('data-title') || '';
      mExpiry.textContent = 'Offer ends ' + (btn.getAttribute('data-expiry') || '') + '.';
      mStore.setAttribute('href', store);
      mCodeWrap.classList.toggle('hidden', !isCode);
      mDealNote.classList.toggle('hidden', isCode);
      if (isCode) {
        mCode.textContent = btn.getAttribute('data-code') || '';
        mCopy.textContent = 'Copy code';
      }
      lastFocus = document.activeElement;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      mClose.focus();
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      if (lastFocus) lastFocus.focus();
    }
    document.querySelectorAll('.coupon-open').forEach((b) => {
      b.addEventListener('click', (e) => { e.preventDefault(); openModal(b); });
    });
    mClose.addEventListener('click', closeModal);
    mBackdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
    mCopy.addEventListener('click', () => copyText(mCode.textContent || '', mCopy, 'Copied!'));
  </script>
</BaseLayout>
