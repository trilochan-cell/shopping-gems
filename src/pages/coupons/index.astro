---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const brands = (await getCollection('brands')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const coupons = await getCollection('coupons');
const today = new Date();
const activeFor = (slug: string) => coupons.filter((c) => c.data.brand === slug && (!c.data.expiry || new Date(c.data.expiry) >= today));
const totalActive = coupons.filter((c) => !c.data.expiry || new Date(c.data.expiry) >= today);
const totalCodes = totalActive.filter((c) => c.data.type === 'code');
const totalDeals = totalActive.filter((c) => c.data.type === 'deal');
const topOffer = (slug: string) => activeFor(slug).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.uses ?? 0) - (a.data.uses ?? 0))[0];
// A–Z index for brand filtering (scales to hundreds of brands)
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((L) => ({
  letter: L,
  count: brands.filter((b) => b.data.name.toUpperCase().startsWith(L)).length,
}));
---
<BaseLayout
  title="Brand Coupons, Promo Codes & Deals — Shopping Gems"
  description={`Verified promo codes & deals for ${brands.length} brands. Browse ${totalActive.length} active coupons and save on every order.`}
  tags={['coupons', 'promo codes', 'deals']}
>
  <p class="my-[18px] text-[13px] text-slate-500"><a href="/" class="hover:text-brand">Home</a> / <span class="text-slate-700">Coupons</span></p>
  <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">Brand Coupons, Promo Codes &amp; Deals</h1>
  <p class="mt-2 max-w-3xl text-slate-600">Every brand below has a dedicated coupon page with tested codes, automatic deals, expiry dates, and terms — re-verified weekly. Pick a brand to start saving.</p>

  <div class="mt-4 grid gap-4 text-center sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="font-display text-3xl font-bold text-brand">{brands.length}</p><p class="mt-1 text-sm font-semibold text-slate-600">Coupon brands</p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="font-display text-3xl font-bold text-brand">{totalActive.length}</p><p class="mt-1 text-sm font-semibold text-slate-600">Active offers</p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="font-display text-3xl font-bold text-brand">{totalCodes.length} + {totalDeals.length}</p><p class="mt-1 text-sm font-semibold text-slate-600">Codes + deals</p></div>
  </div>

  <!-- A–Z brand filter -->
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter brands by letter">
      <button data-letter="ALL" aria-pressed="true" class="az-btn rounded-lg bg-neutral-900 px-3 py-2 text-sm font-bold text-white">All</button>
      {letters.map(({ letter, count }) => (
        <button
          data-letter={letter}
          aria-pressed="false"
          disabled={count === 0}
          title={count === 0 ? `No brands under ${letter}` : `${count} brand${count === 1 ? '' : 's'} under ${letter}`}
          class:list={[
            'az-btn rounded-lg px-3 py-2 text-sm font-bold',
            count === 0
              ? 'cursor-not-allowed text-slate-300'
              : 'text-slate-700 hover:bg-slate-100 hover:text-brand',
          ]}
        >{letter}</button>
      ))}
    </div>
    <p id="brand-count" class="mt-2.5 text-sm text-slate-500">Showing all {brands.length} brands</p>
  </div>

  <div id="brand-grid" class="mt-4 grid gap-[18px] pb-4 sm:grid-cols-2 lg:grid-cols-3">
    {brands.map((b) => {
      const top = topOffer(b.slug);
      return (
        <article data-letter={b.data.name.charAt(0).toUpperCase()} class="brand-card flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="flex items-center gap-3">
              {b.data.logo ? (
                <img src={b.data.logo} alt={`${b.data.name} logo`} width="48" height="48" loading="lazy" class="h-12 w-12 shrink-0 rounded-lg border border-slate-200 bg-white object-contain" />
              ) : (
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-brand font-display text-2xl font-bold text-white" aria-hidden="true">{b.data.name.charAt(0)}</span>
              )}
              <div class="min-w-0">
                <h2 class="font-sans! text-lg font-extrabold leading-tight"><a href={`/coupons/${b.slug}/`} class="hover:text-brand">{b.data.name}</a></h2>
                <p class="truncate text-[13px] text-slate-500">{b.data.tagline}</p>
              </div>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <strong class="text-slate-900">{activeFor(b.slug).length} offers</strong> · up to <strong class="text-brand">{b.data.maxDiscount} off</strong>
              <span class="text-slate-400"> · ★ {b.data.rating}</span>
            </p>
            {top && <p class="mt-1 line-clamp-2 text-sm text-slate-500">Top pick: {top.data.title}</p>}
            <p class="mt-auto pt-4"><a href={`/coupons/${b.slug}/`} class="inline-block rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-brand">View coupons →</a></p>
          </article>
        );
      })}
  </div>
  <p id="brand-empty" class="hidden rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">No brands under this letter yet — check back as we add more stores.</p>

  <section class="prose-sg max-w-3xl pb-6">
    <h2>How Shopping Gems coupon pages work</h2>
    <p>Each brand page lists every active code and deal with its discount, expiry date, terms, and last-verified date. Codes reveal on click with one-tap copy; deals jump straight to the store. Expired codes stay listed for reference, and every outbound store link is marked for transparency.</p>
    <p>New here? Start with our <a href="/sales">sale calendars</a> and <a href="/deals">daily deals</a>, or search the <a href="/search">full guide archive</a>.</p>
  </section>

  <script>
    // A–Z filter (progressive enhancement — all brands visible without JS)
    const azBtns = document.querySelectorAll('.az-btn:not([disabled])');
    const cards = document.querySelectorAll('.brand-card');
    const count = document.getElementById('brand-count');
    const empty = document.getElementById('brand-empty');
    const total = cards.length;
    const paint = (btn) => {
      azBtns.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.className = on
          ? 'az-btn rounded-lg bg-neutral-900 px-3 py-2 text-sm font-bold text-white'
          : 'az-btn rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 hover:text-brand';
      });
    };
    azBtns.forEach((btn) => btn.addEventListener('click', () => {
      const L = btn.getAttribute('data-letter');
      paint(btn);
      let shown = 0;
      cards.forEach((c) => {
        const show = L === 'ALL' || c.getAttribute('data-letter') === L;
        c.classList.toggle('hidden', !show);
        if (show) shown++;
      });
      count.textContent = L === 'ALL' ? `Showing all ${total} brands` : `Showing ${shown} brand${shown === 1 ? '' : 's'} under “${L}”`;
      empty.classList.toggle('hidden', shown > 0);
    }));
  </script>
</BaseLayout>
