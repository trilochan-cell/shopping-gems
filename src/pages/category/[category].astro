---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const cats = [...new Set(posts.map((p) => p.data.category))];
  const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  return cats.map((c) => ({ params: { category: slugify(c) }, props: { name: c } }));
}
const { name } = Astro.props;
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const all = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = all.filter((p) => p.data.category === name);
const recent = all.slice(0, 4).map((p) => ({ slug: p.slug, title: p.data.title, pubDate: p.data.pubDate, image: p.data.image, imageAlt: p.data.imageAlt }));
const categories = [...new Set(all.map((p) => p.data.category))].map((c) => ({ name: c, slug: slugify(c), count: all.filter((p) => p.data.category === c).length }));
const tags = [...new Set(all.flatMap((p) => p.data.tags))];
---
<BaseLayout title={`${name} — Shopping Gems`} description={`All ${name} shopping guides, sales and deals on Shopping Gems.`}>
  <p class="my-[18px] text-[13px] text-slate-500"><a href="/" class="hover:text-brand">Home</a> / <span class="text-slate-700">{name}</span></p>
  <h1 class="text-3xl font-extrabold tracking-tight">{name}</h1>
  <p class="mt-2 text-slate-600">{posts.length} {posts.length === 1 ? 'guide' : 'guides'} — coupons, sale dates and honest picks.</p>
  <div class="mt-4 grid gap-8 pb-4 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="grid min-w-0 content-start gap-[18px] sm:grid-cols-2">
      {posts.map((p) => (<PostCard slug={p.slug} title={p.data.title} description={p.data.description} category={p.data.category} pubDate={p.data.pubDate} views={p.data.views} image={p.data.image} imageAlt={p.data.imageAlt} />))}
      {posts.length === 0 && <p class="text-slate-600">No posts yet in {name}.</p>}
    </div>
    <Sidebar recent={recent} categories={categories} tags={tags} />
  </div>
</BaseLayout>
