---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
const categories = [...new Set(posts.map((p) => p.data.category))];
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<BaseLayout title="About Us — Shopping Gems" description="Shopping Gems is the best shopping blog: sale calendars, coupons, gift guides and honest deal picks so you never pay full price.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Us — Shopping Gems",
      "url": "http://localhost:4321/about",
      "about": { "@type": "Organization", "name": "Shopping Gems", "description": "Shopping blog covering sale calendars, coupons and honest deal picks." }
    })} />
  </Fragment>
  <p class="my-[18px] text-[13px] text-slate-500"><a href="/" class="hover:text-brand">Home</a> / <span class="text-slate-700">About Us</span></p>

  <div class="max-w-3xl">
    <p class="text-[12px] font-bold uppercase tracking-[2px] text-slate-500">About Shopping Gems</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">The best shopping blog for people who hate paying full price</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600"><strong class="text-slate-900">Shopping Gems</strong> tracks sale dates, coupons and price drops across Amazon, AliExpress and more — then turns them into short, practical guides so you always buy at the right moment.</p>
  </div>

  <div class="mt-6 grid gap-4 text-center sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-3xl font-black text-brand">{posts.length}+</p><p class="mt-1 text-sm font-semibold text-slate-600">Deal guides published</p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-3xl font-black text-brand">{categories.length}</p><p class="mt-1 text-sm font-semibold text-slate-600">Shopping categories</p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-3xl font-black text-brand">100%</p><p class="mt-1 text-sm font-semibold text-slate-600">Free, no paywalls</p></div>
  </div>

  <h2 class="mb-4 mt-10 text-2xl font-extrabold tracking-tight">What we cover</h2>
  <div class="grid gap-[18px] sm:grid-cols-2">
    <a href="/sales" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-brand"><h3 class="flex items-center gap-2 font-extrabold"><Icon name="calendar" cls="h-4 w-4 text-brand" /> Sale calendars</h3><p class="mt-1 text-sm text-slate-600">Expected dates for Amazon Prime Day, 11.11, Black Friday and every AliExpress event.</p></a>
    <a href="/deals" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-brand"><h3 class="flex items-center gap-2 font-extrabold"><Icon name="bolt" cls="h-4 w-4 text-brand" /> Daily deals</h3><p class="mt-1 text-sm text-slate-600">Lightning deals, gifts under $20 and trending finds worth your money.</p></a>
    <a href="/category/gift-guides" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-brand"><h3 class="flex items-center gap-2 font-extrabold"><Icon name="gift" cls="h-4 w-4 text-brand" /> Gift guides</h3><p class="mt-1 text-sm text-slate-600">Affordable, meaningful picks for birthdays, festivals and holidays.</p></a>
    <a href="/category/online-shopping" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-brand"><h3 class="flex items-center gap-2 font-extrabold"><Icon name="store" cls="h-4 w-4 text-brand" /> Coupon playbooks</h3><p class="mt-1 text-sm text-slate-600">Coupon-stacking tactics that beat most "mega deal" banners.</p></a>
  </div>

  <div class="prose-sg mt-10 max-w-3xl">
    <h2>How we make money (honestly)</h2>
    <p>Shopping Gems is free forever. When you buy through some links on this site, retailers may pay us a small commission — at zero extra cost to you. It keeps the lights on and never affects what we recommend. Read the full details in our <a href="/privacy">Privacy Policy</a>.</p>
    <h2>Our promise</h2>
    <ul>
      <li><strong>Real prices, not fake discounts</strong> — we compare against price history, not strikethrough MRPs.</li>
      <li><strong>Short, skimmable guides</strong> — dates, steps and FAQs, no 3,000-word fluff.</li>
      <li><strong>Updated calendars</strong> — sale pages are revised the moment dates are confirmed.</li>
    </ul>
    <h2>Frequently asked questions</h2>
    <h3>Is Shopping Gems free?</h3>
    <p>Yes — every guide, calendar and deal roundup is free with no account or paywall.</p>
    <h3>How often is the site updated?</h3>
    <p>Deal picks refresh regularly and sale calendars are updated as soon as retailers confirm dates.</p>
    <h3>Can I suggest a deal or topic?</h3>
    <p>Absolutely — head to our <a href="/contact">Contact page</a> and send it over. Reader tips start many of our guides.</p>
  </div>

  <div class="mt-10 flex flex-wrap gap-3 pb-4">
    <a href="/deals" class="rounded-full bg-brand px-6 py-3 font-bold text-white hover:bg-brand-dark">Browse today's deals →</a>
    <a href="/contact" class="rounded-full border border-slate-200 bg-white px-6 py-3 font-bold text-ink hover:border-brand hover:text-brand">Get in touch</a>
  </div>
</BaseLayout>
