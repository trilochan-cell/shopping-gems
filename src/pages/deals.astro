---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const all = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = all.filter((p) => p.data.tags.includes('deals') || p.data.tags.includes('sale'));
const recent = all.slice(0, 4).map((p) => ({ slug: p.slug, title: p.data.title, pubDate: p.data.pubDate, image: p.data.image, imageAlt: p.data.imageAlt }));
const categories = [...new Set(all.map((p) => p.data.category))].map((c) => ({ name: c, slug: slugify(c), count: all.filter((p) => p.data.category === c).length }));
const tags = [...new Set(all.flatMap((p) => p.data.tags))];
---
<BaseLayout title="Sales & Deals — Shopping Gems" description="Sale calendars, expected dates, coupons and hand-picked deals — every way to never pay full price.">
  <p class="my-[18px] text-[13px] text-slate-500"><a href="/" class="hover:text-brand">Home</a> / <span class="text-slate-700">Sales &amp; Deals</span></p>
  <h1 class="text-3xl font-extrabold tracking-tight">Sales &amp; Deals</h1>
  <p class="mt-2 text-slate-600">Sale calendars, coupon-stacking guides, lightning drops and trending discounts — one hub for every saving.</p>
  <div class="mt-4 grid gap-8 pb-4 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="grid min-w-0 content-start gap-[18px] sm:grid-cols-2">
      {posts.map((p) => (<PostCard slug={p.slug} title={p.data.title} description={p.data.description} category={p.data.category} pubDate={p.data.pubDate} views={p.data.views} image={p.data.image} imageAlt={p.data.imageAlt} cta="Get deal" />))}
    </div>
    <Sidebar recent={recent} categories={categories} tags={tags} />
  </div>
</BaseLayout>
