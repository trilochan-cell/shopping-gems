---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.filter(p => p.data.featured).slice(0, 3);
const latest = posts.slice(0, 6);
const brands = await getCollection('brands');
const coupons = await getCollection('coupons');
const today = new Date();
const brandOffers = (slug: string) => coupons.filter((c) => c.data.brand === slug && new Date(c.data.expiry) >= today).length;
const fmt = (d: Date) => new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<BaseLayout title="Shopping Gems — Best Online Shopping Blogs, Coupons & Deals" description="Shopping Gems is the best shopping blog: AliExpress & Amazon sale dates, coupons, deals and honest shopping guides.">
  <section class="py-8">
    <div class="mb-5 flex items-center gap-4">
      <h2 class="shrink-0 text-[13px] font-bold uppercase tracking-[2px] text-slate-500">Featured stories</h2>
      <span aria-hidden="true" class="h-px flex-1 bg-slate-200"></span>
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      {featured[0] && (
        <a href={`/posts/${featured[0].slug}/`} class="group relative flex min-h-[380px] items-end overflow-hidden rounded-2xl bg-neutral-900">
          <img class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.02]" src={featured[0].data.image} alt={featured[0].data.imageAlt ?? featured[0].data.title} loading="eager" />
          <div class="relative w-full bg-gradient-to-t from-black/80 via-black/35 to-transparent p-6 text-white md:p-7">
            <span class="inline-block rounded-full bg-brand px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white">{featured[0].data.category}</span>
            <h2 class="my-2.5 max-w-[22ch] font-display text-3xl font-black leading-[1.1] md:text-4xl">{featured[0].data.title}</h2>
            <p class="mt-1 max-w-[52ch] text-[15px] leading-relaxed text-slate-200">{featured[0].data.description}</p>
            <div class="mt-3 flex flex-wrap items-center gap-3 text-[13px] text-slate-300"><span>{fmt(featured[0].data.pubDate)}</span><span aria-hidden="true">·</span><span>{featured[0].data.views} Views</span><span aria-hidden="true">·</span><span class="font-bold text-white">Read guide →</span></div>
          </div>
        </a>
      )}
      <div class="flex flex-col divide-y divide-slate-200 border-y border-slate-200">
        {featured.slice(1).map((p, i) => (
          <a href={`/posts/${p.slug}/`} class="group flex flex-1 items-center gap-4 py-4 first:pt-1 last:pb-1">
            <span aria-hidden="true" class="font-display text-3xl font-black text-slate-200 transition group-hover:text-brand">{String(i + 2).padStart(2, '0')}</span>
            <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} loading="lazy" class="h-20 w-24 shrink-0 rounded-lg object-cover" />
            <span class="min-w-0">
              <span class="text-[11px] font-bold uppercase tracking-[1.5px] text-brand">{p.data.category}</span>
              <span class="mt-0.5 line-clamp-2 block font-display text-[17px] font-bold leading-snug group-hover:text-brand">{p.data.title}</span>
              <span class="mt-1 block text-[12.5px] text-slate-500">{fmt(p.data.pubDate)} · {p.data.views} Views</span>
            </span>
          </a>
        ))}
        <a href="/deals" class="group flex items-center justify-between py-4 text-sm font-bold text-ink hover:text-brand">
          <span>Browse all sales &amp; deals guides</span>
          <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <div class="mb-4 mt-[34px] flex items-center justify-between">
    <h2 class="text-[26px] font-extrabold tracking-tight">Latest Posts</h2>
    <a href="/deals" class="rounded-full border border-slate-200 bg-white px-[18px] py-2.5 font-bold text-ink hover:border-brand hover:text-brand">View all deals</a>
  </div>
  <div class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
    {latest.map((p) => (
      <PostCard slug={p.slug} title={p.data.title} description={p.data.description} category={p.data.category} pubDate={p.data.pubDate} views={p.data.views} image={p.data.image} imageAlt={p.data.imageAlt} />
    ))}
  </div>

  <div class="mb-4 mt-[34px] flex items-center justify-between">
    <h2 class="text-[26px] font-extrabold tracking-tight">Top coupon brands</h2>
    <a href="/coupons" class="rounded-full border border-slate-200 bg-white px-[18px] py-2.5 text-sm font-bold text-ink hover:border-brand hover:text-brand">All brands →</a>
  </div>
  <div class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
    {brands.slice(0, 3).map((b) => (
      <a href={`/coupons/${b.slug}/`} class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:shadow-lg">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-brand font-display text-2xl font-bold text-white" aria-hidden="true">{b.data.name.charAt(0)}</span>
        <span class="min-w-0">
          <span class="block truncate text-[16px] font-extrabold">{b.data.name}</span>
          <span class="block text-sm text-slate-500">{brandOffers(b.slug)} offers · up to <strong class="text-brand">{b.data.maxDiscount} off</strong></span>
        </span>
      </a>
    ))}
  </div>

  <section class="mt-[34px] overflow-hidden rounded-xl border border-slate-200 bg-alice-blue p-[22px]">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-[12px] font-bold uppercase tracking-[2px] text-slate-500">Hand-picked daily</p>
        <h2 class="mt-1 text-[26px] font-extrabold tracking-tight">Best Amazon Deals You Can't Miss!</h2>
      </div>
      <a href="/deals" class="rounded-full border border-slate-200 bg-white px-[18px] py-2.5 text-sm font-bold text-ink hover:border-brand hover:text-brand">View all deals →</a>
    </div>
    <div class="grid gap-[18px] md:grid-cols-3">
      <article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-xl">
        <a href="/deals" class="relative block aspect-[16/10] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1513201099705-a9746e1e201f?w=800&q=80&auto=format&fit=crop" alt="Wrapped gift boxes under $20" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <span class="absolute left-3 top-3 rounded-full bg-brand px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white">Under $20</span>
        </a>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-lg font-extrabold leading-snug"><a href="/deals" class="group-hover:text-brand">Small Gifts Under $20</a></h3>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-600">Thoughtful birthday, festive &amp; return gifts that look premium — all under twenty bucks.</p>
          <p class="mt-auto pt-4"><a href="/deals" class="inline-block rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-bold text-white group-hover:bg-brand">Shop gifts →</a></p>
        </div>
      </article>
      <article class="group flex flex-col overflow-hidden rounded-xl border-2 border-brand bg-white transition hover:-translate-y-1 hover:shadow-xl">
        <a href="/deals" class="relative block aspect-[16/10] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&q=80&auto=format&fit=crop" alt="Clothing store rack with sale discounts" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <span class="absolute left-3 top-3 rounded-full bg-neutral-900 px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white">Ending soon</span>
        </a>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-lg font-extrabold leading-snug"><a href="/deals" class="group-hover:text-brand">Lightning Deals</a></h3>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-600">Time-bound price drops on tech, home &amp; fashion. When the timer hits zero, so does the price.</p>
          <p class="mt-auto pt-4"><a href="/deals" class="inline-block rounded-full bg-brand px-5 py-2.5 text-sm font-bold text-white hover:bg-brand-dark">Grab deals →</a></p>
        </div>
      </article>
      <article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-xl">
        <a href="/deals" class="relative block aspect-[16/10] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1472851294608-062f824d29cc?w=800&q=80&auto=format&fit=crop" alt="Open shop sign — trending products right now" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <span class="absolute left-3 top-3 rounded-full bg-stormy-teal px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white">Trending</span>
        </a>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-lg font-extrabold leading-snug"><a href="/deals" class="group-hover:text-brand">Trending Deals</a></h3>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-600">The most-clicked, most-wishlisted finds our readers can't stop buying this week.</p>
          <p class="mt-auto pt-4"><a href="/deals" class="inline-block rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-bold text-white group-hover:bg-brand">Explore →</a></p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
